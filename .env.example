# Copy to .env for local runs. In Base44 these are Secrets (Dashboard -> Secrets). NEVER commit real values.

# Swarms (cloud.swarms.world -> API keys)
SWARMS_API_KEY=
SWARMS_MODEL=gpt-5.4-mini
# Live function (backend/askCity.function.js): "sequential" uses /v1/swarm/completions (graph-workflow is premium)
SWARMS_WORKFLOW=sequential
# Pipeline (src/): optional, "swarm" | "agent" | "graph" = which way to call Swarms first (default swarm)
SWARMS_ENDPOINT=

# Prune (OpenAI-compatible: https://api.withprune.com/v1/chat/completions)
PRUNE_API_KEY=
PRUNE_MODEL=
PRUNE_BASE_URL=https://api.withprune.com

# Live function only: unlocks the admin sponsor demo
SPONSOR_DEMO_TOKEN=
